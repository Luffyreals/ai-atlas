---
// The close: the back of a postcard, with a stamp, a sign-off, the address block and the imprint.
import { Picture } from 'astro:assets';
import { CC_LICENCE_URL, HOME } from '@data/home';
import { ALL_PICTURES, STAMP_PICTURE } from '@data/home-pictures';
import { LESSONS, type Locale } from '@data/roadmap';
import { formatString } from '@i18n/format';
import { getStrings } from '@i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { footer } = HOME;
const t = getStrings(Astro.locals.t, 'home');
const otherLocale: Locale = locale === 'vi' ? 'en' : 'vi';
const credits = [...new Map(ALL_PICTURES.map((picture) => [picture.credit.source, picture.credit])).values()];
---

<footer class="postcard-wrap" aria-labelledby="postcard-title">
  <div class="postcard">
    <svg class="postcard-edge" aria-hidden="true" focusable="false" preserveAspectRatio="none">
      <defs>
        <pattern id="postcard-scallop" width="96" height="28" patternUnits="userSpaceOnUse">
          <ellipse cx="48" cy="28" rx="48" ry="28" fill="currentColor"></ellipse>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#postcard-scallop)"></rect>
    </svg>
    <div class="postcard-body">
      <div class="postcard-message">
        <h2 id="postcard-title">{footer.signoff[locale]}</h2>
        <p>{footer.message[locale]}</p>
      </div>
      <div class="postcard-address">
        <figure class="postcard-stamp">
          <Picture
            src={STAMP_PICTURE.src}
            alt={STAMP_PICTURE.alt[locale]}
            widths={[88, 176]}
            sizes="88px"
            formats={['avif', 'webp']}
          />
        </figure>
        <ul>
          <li><a href="#map">{formatString(footer.linkMap[locale], { count: LESSONS.length })}</a></li>
          <li><a href="#terms">{footer.linkTerms[locale]}</a></li>
          <li><a href={CC_LICENCE_URL[locale]} rel="license">{footer.linkLicence[locale]}</a></li>
          <li>
            <a href={`/${otherLocale}/`} hreflang={otherLocale} lang={otherLocale} title={t.otherLanguageName}>
              {t.otherLanguage}
            </a>
          </li>
        </ul>
      </div>
    </div>
    <p class="postcard-imprint">{footer.imprint[locale]}</p>
  </div>

  <details class="credits">
    <summary>{footer.creditsTitle[locale]}</summary>
    <ul>
      {
        credits.map((credit) => (
          <li>
            <a href={credit.source} lang="en">
              {credit.title}
            </a>
            {' · '}
            {formatString(footer.creditLine[locale], {
              creator: credit.creator[locale],
              year: credit.year[locale],
              licence: credit.licence[locale],
              via: credit.via[locale],
            })}
          </li>
        ))
      }
    </ul>
  </details>
</footer>

<style>
  .postcard-wrap {
    padding: var(--section-gap) var(--edge) 48px;
    background: var(--atlas-ground);
    color: var(--atlas-ground-ink);
  }

  .postcard {
    max-width: 1100px;
    margin: 0 auto;
    color: var(--atlas-paper-ink);
  }

  .postcard-edge {
    display: block;
    width: 100%;
    height: 20px;
    color: var(--atlas-paper);
  }

  .postcard-body {
    display: grid;
    gap: 40px;
    padding: 32px 24px;
    background: var(--atlas-paper);
  }

  .postcard-message {
    display: grid;
    align-content: start;
    gap: 16px;
  }

  .postcard-message h2 {
    font-size: var(--step-head);
  }

  .postcard-message p {
    max-width: 40ch;
    margin: 0;
  }

  .postcard-address {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 24px;
  }

  .postcard-address ul {
    display: grid;
    gap: 12px;
    grid-row: 1;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step-body);
  }

  .postcard-address a {
    color: var(--atlas-paper-ink);
    text-decoration-color: var(--atlas-field);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s ease;
  }

  .postcard-address a:hover {
    text-decoration-color: var(--atlas-paper-ink);
  }

  .postcard-stamp {
    grid-row: 1;
    grid-column: 2;
    width: 64px;
    margin: 0;
    padding: 6px;
    background: var(--atlas-paper-step);
    transform: rotate(3deg);
  }

  .postcard-stamp :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .postcard-imprint {
    margin: 0;
    padding: 0 24px 24px;
    background: var(--atlas-paper);
    color: var(--atlas-paper-muted);
    font-size: var(--step-small);
    text-align: center;
  }

  .credits {
    max-width: 1100px;
    margin: 32px auto 0;
    color: var(--atlas-ground-muted);
    font-size: var(--step-small);
  }

  .credits summary {
    cursor: pointer;
    color: var(--atlas-ground-ink);
  }

  .credits ul {
    display: grid;
    max-width: 75ch;
    gap: 6px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .credits a {
    color: var(--atlas-ground-ink);
  }

  @media (min-width: 50rem) {
    .postcard-edge {
      height: 28px;
    }

    .postcard-body {
      grid-template-columns: 1fr 1fr;
      padding: 48px 56px 40px;
    }

    .postcard-stamp {
      width: 88px;
    }

    .postcard-imprint {
      padding: 0 56px 28px;
    }
  }
</style>

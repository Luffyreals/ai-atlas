---
// The AI Atlas mark: four stops on one road, then the fork into NLP, CV and LLM.
// Drawn in currentColor so it takes the ink of whatever it sits on.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={['route-mark', className]} viewBox="0 0 40 32" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 16H22M22 16L34 6M22 16H34M22 16L34 26"></path>
  </g>
  <g fill="currentColor">
    <circle cx="4" cy="16" r="3"></circle>
    <circle cx="10" cy="16" r="2"></circle>
    <circle cx="16" cy="16" r="2"></circle>
    <circle cx="22" cy="16" r="3"></circle>
    <circle cx="34" cy="6" r="3"></circle>
    <circle cx="34" cy="16" r="3"></circle>
    <circle cx="34" cy="26" r="3"></circle>
  </g>
</svg>

<style>
  .route-mark {
    display: inline-block;
    width: auto;
    height: 1em;
    vertical-align: -0.1em;
  }
</style>

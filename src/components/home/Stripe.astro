---
// The neatline of an atlas plate: alternating bars of ink and paper, drawn as filled shapes.
// Styles: src/styles/roadmap-map.css (customCss), at zero specificity so a parent's class wins.
interface Props {
  /** Unique id for the SVG pattern (two stripes on one page must not share it). */
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<svg class:list={['stripe', className]} aria-hidden="true" focusable="false" preserveAspectRatio="none">
  <defs>
    <pattern id={id} width="56" height="10" patternUnits="userSpaceOnUse">
      <rect width="28" height="10" fill="currentColor"></rect>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
</svg>

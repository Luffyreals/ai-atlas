---
// The homepage, rendered through Starlight's Hero slot (see src/components/starlight/Hero.astro).
import RoadmapMap from '@components/RoadmapMap.astro';
import { HOME } from '@data/home';
import { LESSONS } from '@data/roadmap';
import { getPageLocale } from '@lib/page-locale';
import { formatString } from '@i18n/format';
import HomeFooter from './HomeFooter.astro';
import HomeHero from './HomeHero.astro';
import HomeLesson from './HomeLesson.astro';
import HomeLetter from './HomeLetter.astro';
import HomeRoute from './HomeRoute.astro';
import HomeTerms from './HomeTerms.astro';

const locale = getPageLocale(Astro.locals.starlightRoute);
const lessonCount = { count: LESSONS.length };
---

<script is:inline>
  // Entrance motion is opt-in: without script every element stays visible.
  document.documentElement.classList.add('atlas-motion');
</script>

<div class="atlas-home not-content">
  <HomeHero locale={locale} />
  <HomeRoute locale={locale} />
  <section id="map" class="map-section" aria-labelledby="map-title">
    <RoadmapMap routeFinder destination="ml/linear-regression">
      <h2 id="map-title" slot="title" data-reveal>{formatString(HOME.map.heading[locale], lessonCount)}</h2>
      <p slot="intro" data-reveal style="--i: 1">{HOME.map.intro[locale]}</p>
    </RoadmapMap>
  </section>
  <HomeLesson locale={locale} />
  <HomeTerms locale={locale} />
  <HomeLetter locale={locale} />
  <HomeFooter locale={locale} />
</div>

<style is:global>
  /* The homepage uses the full width: lift Starlight's content frame on this page only. */
  :root[data-has-hero] main {
    padding: 0;
  }

  :root[data-has-hero] .content-panel {
    padding: 0;
  }

  :root[data-has-hero] .content-panel .sl-container {
    max-width: none;
    margin: 0;
  }

  :root[data-has-hero] .content-panel .sl-container > :not(.atlas-home) {
    display: none;
  }

  /* Starlight spaces siblings in the container; the homepage starts right under the header. */
  :root[data-has-hero] .content-panel .sl-container > .atlas-home {
    margin-top: 0;
  }

  /* The hero's own ground meets the header; no rule between them. */
  :root[data-has-hero] header.header {
    border-bottom-color: transparent;
  }

  .atlas-home {
    --edge: clamp(16px, 2vw, 32px);
    --gap: 12px;
    --section-gap: clamp(72px, 8vw, 128px);
    --step-small: 1rem;
    --step-body: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    --step-lead: clamp(1.375rem, 1.15rem + 0.9vw, 1.875rem);
    --step-head: clamp(2.375rem, 1.35rem + 3vw, 4rem);
    --step-display: clamp(3.5rem, 1.6rem + 6.5vw, 8.25rem);
    --ease-out: cubic-bezier(0.2, 0.7, 0.2, 1);
    /* Focus ring colour follows the surface it sits on (set again on paper and walnut surfaces). */
    --atlas-focus: var(--sl-color-white);

    font-family: var(--sl-font);
    font-size: var(--step-body);
    line-height: 1.5;
    color: var(--sl-color-white);
    background: var(--sl-color-black);
  }

  /* Zero specificity, so each component's own heading styles win. Vietnamese marks need air:
     a leading under 1.05 lets a dot below one line touch the line beneath. */
  :where(.atlas-home) :where(h1, h2, h3, h4) {
    margin: 0;
    color: inherit;
    font-family: var(--atlas-font-display);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  :where(.atlas-home) figure {
    margin: 0;
  }

  .atlas-home :is(.hero-card, .roadmap, .sheet, .sheet-stub, .postcard, .slip) {
    --atlas-focus: var(--atlas-paper-ink);
  }

  .atlas-home :is(.hero-plates, .lesson-text, .postcard-wrap) {
    --atlas-focus: var(--atlas-ground-ink);
  }

  .atlas-home .map-section {
    --atlas-focus: var(--atlas-field-ink);
  }

  .atlas-home .atlas-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 28px;
    background: var(--atlas-paper-ink);
    color: var(--atlas-paper);
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s var(--ease-out), background-color 0.2s ease;
  }

  .atlas-home .atlas-button:hover {
    transform: translateY(-2px);
    background: var(--atlas-ground-step);
  }

  .atlas-home .atlas-button:active {
    transform: translateY(0);
  }

  .atlas-home :is(a, button, select, summary, [tabindex]):focus-visible {
    outline: 3px solid var(--atlas-focus);
    outline-offset: 3px;
  }

  .atlas-home .map-section {
    padding: var(--section-gap) var(--edge);
    background: var(--atlas-field);
  }

  .atlas-home .map-section .roadmap {
    max-width: 1320px;
    margin: 0 auto;
  }

  /* Entrance: each part of a section rises in turn, once, as the section arrives. */
  .atlas-motion .atlas-home [data-reveal] {
    opacity: 0;
    translate: 0 24px;
    transition:
      opacity 0.7s var(--ease-out) calc(var(--i, 0) * 80ms),
      translate 0.7s var(--ease-out) calc(var(--i, 0) * 80ms);
  }

  .atlas-motion .atlas-home [data-reveal].is-in {
    opacity: 1;
    translate: 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .atlas-motion .atlas-home [data-reveal] {
      translate: 0 0;
      transition: opacity 0.2s linear;
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('.atlas-home [data-reveal]');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );
    items.forEach((item) => observer.observe(item));
  } else {
    items.forEach((item) => item.classList.add('is-in'));
  }
</script>

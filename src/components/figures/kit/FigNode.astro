---
// A box of a static figure (docs/architecture/viz.md, sections 8.2 e–f, 8.4): a rect and 1–3 centred lines,
// main lines (15 units, bold) above small ones (13 units). Tones: plain; accent (2px accent border, accent-low
// fill) for the focus; alt (dashed blue border) for a second group. Colours and strokes: figures.css, by
// data-tone. Font sizes are attributes, so the line positions here and the e2e size check use the real ones.
// The build fails when the box holds more than 3 lines, an empty line, or is too short for its lines.
import type { Lines } from '@data/figures/types';
import { FIG_FONT, MAX_NODE_LINES, NODE_PADDING, LINE_HEIGHT, round1, stackOffsets, toLines } from '@lib/figures/geometry';

interface Props {
  x: number;
  y: number;
  width: number;
  height: number;
  /** Main lines, bold. */
  lines: Lines;
  /** Smaller lines under the main ones. */
  small?: Lines;
  tone?: 'plain' | 'accent' | 'alt';
}

const { x, y, width, height, tone = 'plain' } = Astro.props;
const main = toLines(Astro.props.lines);
const small = Astro.props.small === undefined ? [] : toLines(Astro.props.small);
const all = [...main, ...small];
const where = `<FigNode> "${all.join(' / ')}" on "${Astro.locals.starlightRoute.id}"`;

if (main.length === 0) throw new Error(`${where}: needs at least one main line.`);
if (all.length > MAX_NODE_LINES) throw new Error(`${where}: at most ${MAX_NODE_LINES} lines, got ${all.length}.`);
if (all.some((line) => !line.trim())) throw new Error(`${where}: has an empty line.`);

const sizes = [...main.map(() => FIG_FONT.label), ...small.map(() => FIG_FONT.small)];
const textHeight = sizes.reduce((sum, size) => sum + size * LINE_HEIGHT, 0);
if (height < textHeight + 2 * NODE_PADDING) {
  throw new Error(`${where}: height ${height} is under ${round1(textHeight + 2 * NODE_PADDING)} (lines + ${NODE_PADDING} each side).`);
}

const cx = round1(x + width / 2);
const cy = y + height / 2;
const offsets = stackOffsets(sizes);
const mainLines = main.map((line, i) => ({ line, y: round1(cy + (offsets[i] ?? 0)) }));
const smallLines = small.map((line, i) => ({ line, y: round1(cy + (offsets[main.length + i] ?? 0)) }));
---

<g class="atlas-fig-node" data-tone={tone}>
  <rect x={x} y={y} width={width} height={height}></rect>
  <text class="atlas-fig-text" font-size={FIG_FONT.label} text-anchor="middle" dominant-baseline="central">
    {mainLines.map((item) => <tspan x={cx} y={item.y}>{item.line}</tspan>)}
  </text>
  {
    smallLines.length > 0 && (
      <text class="atlas-fig-text-sm" font-size={FIG_FONT.small} text-anchor="middle" dominant-baseline="central">
        {smallLines.map((item) => <tspan x={cx} y={item.y}>{item.line}</tspan>)}
      </text>
    )
  }
</g>

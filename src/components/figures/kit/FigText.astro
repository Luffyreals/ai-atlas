---
// Free text of a static figure, outside boxes (docs/architecture/viz.md, section 8.4): lines as <tspan>,
// centred as a block on y, anchored at x by start, middle or end. "label" is 15 units and bold, "small" is
// 13 units and muted; the size is an attribute, colours are in figures.css.
import type { Lines } from '@data/figures/types';
import { FIG_FONT, MAX_NODE_LINES, lineOffsets, round1, toLines } from '@lib/figures/geometry';

interface Props {
  x: number;
  /** Vertical centre of the lines. */
  y: number;
  lines: Lines;
  size?: 'label' | 'small';
  anchor?: 'start' | 'middle' | 'end';
}

const { x, y, size = 'label', anchor = 'middle' } = Astro.props;
const lines = toLines(Astro.props.lines);
const where = `<FigText> "${lines.join(' / ')}" on "${Astro.locals.starlightRoute.id}"`;
if (lines.length === 0 || lines.length > MAX_NODE_LINES) throw new Error(`${where}: needs 1–${MAX_NODE_LINES} lines.`);
if (lines.some((line) => !line.trim())) throw new Error(`${where}: has an empty line.`);

const fontSize = FIG_FONT[size];
const offsets = lineOffsets(lines.length, fontSize);
---

<text
  class={size === 'label' ? 'atlas-fig-text' : 'atlas-fig-text-sm'}
  font-size={fontSize}
  text-anchor={anchor}
  dominant-baseline="central"
>
  {lines.map((line, i) => <tspan x={x} y={round1(y + (offsets[i] ?? 0))}>{line}</tspan>)}
</text>

---
// A connector of a static figure (docs/architecture/viz/figures.md, sections 8.3–8.4): a polyline from `from` through
// `via` to `to`, and a head drawn as a polygon at `to` (no <marker>: it needs a page-unique id, and colouring
// it by the line is not reliable across browsers). The line stops inside the head, so no stroke pokes past
// the tip. Colours and stroke: figures.css.
import { ARROW_HEAD, arrowHead, pointBefore, round1, type Pt } from '@lib/figures/geometry';

interface Props {
  from: Pt;
  to: Pt;
  /** Bends, in order. */
  via?: readonly Pt[];
}

const { from, to, via = [] } = Astro.props;
const points: readonly Pt[] = [from, ...via, to];
const last = points[points.length - 2] ?? from;
if (Math.hypot(to[0] - last[0], to[1] - last[1]) < ARROW_HEAD) {
  throw new Error(
    `<FigArrow> to ${to.join(',')} on "${Astro.locals.starlightRoute.id}": the last segment is shorter than its head (${ARROW_HEAD}).`,
  );
}

const lineEnd = pointBefore(last, to, ARROW_HEAD - 1);
const line = [...points.slice(0, -1), lineEnd].map(([x, y]) => `${round1(x)},${round1(y)}`).join(' ');
---

<polyline class="atlas-fig-arrow" points={line}></polyline>
<polygon class="atlas-fig-arrow-head" points={arrowHead(last, to)}></polygon>

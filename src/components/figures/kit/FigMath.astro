---
// A short math label of a static figure (docs/architecture/viz.md, sections 11.3, 11.4.2): an italic symbol,
// an optional subscript (13 units, moved down with dy, since baseline-shift is not Baseline and Barlow has no
// U+2080–2089) and an optional upright tail ("= 0", after dx = 3). Language-neutral, so it is written in the
// figure component; checkMathLabel fails the build when words try to slip in. The tspans sit on ONE line below:
// a line break between them would draw a space ("w 1"). Colour and weight 400: figures.css (.atlas-fig-math).
import { FIG_FONT, checkMathLabel, round1 } from '@lib/figures/geometry';

interface Props {
  x: number;
  /** Vertical centre, dominant-baseline: central, like FigText. */
  y: number;
  /** One Latin or Greek letter, italic. */
  symbol: string;
  /** 1–2 digits or Latin letters, always FIG_FONT.small. */
  sub?: string;
  /** Math characters only, upright. */
  after?: string;
  size?: 'label' | 'small';
  anchor?: 'start' | 'middle' | 'end';
}

const { x, y, symbol, sub, after, size = 'label', anchor = 'middle' } = Astro.props;
try {
  checkMathLabel(symbol, sub, after);
} catch (error) {
  throw new Error(`<FigMath> on "${Astro.locals.starlightRoute.id}": ${error instanceof Error ? error.message : String(error)}`);
}
const fontSize = FIG_FONT[size];
const shift = round1(0.3 * fontSize);
---

<text class="atlas-fig-math" font-size={fontSize} text-anchor={anchor} dominant-baseline="central" x={x} y={y}><tspan font-style="italic">{symbol}</tspan>{sub !== undefined && <tspan font-size={FIG_FONT.small} dy={shift}>{sub}</tspan>}{after !== undefined && <tspan dy={sub !== undefined ? -shift : undefined} dx="3">{after}</tspan>}</text>

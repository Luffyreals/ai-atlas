---
// A short math label of a static figure (docs/architecture/viz/static-plots.md, sections 11.3, 11.4.2): an italic symbol,
// an optional subscript (13 units, moved down with dy, since baseline-shift is not Baseline and Barlow has no
// U+2080–2089) and an optional upright tail ("= 0", after dx = 3). Language-neutral, so it is written in the
// figure component; checkMathLabel fails the build when words try to slip in. The tspans sit on ONE line below:
// a line break between them would draw a space ("w 1"). Colour and weight 400: figures.css (.atlas-fig-math).
// Added for the LLM figures (docs/architecture/llm-lessons.md, section 2.9.2): `bold` draws the symbol upright
// and bold (600, loaded), the site's \mathbf for vectors and matrices (x, W); `before` is an upright math
// head ("×" of "× N"), dx = 3 before the symbol. FigNode draws one of these as its `math` row.
// The central baseline and the middle anchor come from figures.css (llm-lessons.md 2.9.3): only start and end
// are written.
// Added for the DL figures (docs/architecture/dl-lessons.md, section 4.2): a sub that starts with a letter is
// italic, as KaTeX sets h_t and h_{t−1} (Barlow 400 italic is loaded); `tilde` puts a "~" over a bold symbol
// (the candidates h̃_t, c̃_t), placed by tildeShift in src/lib/figures/tilde.ts.
import { FIG_FONT, checkMathLabel, round1, type MathLabel } from '@lib/figures/geometry';
import { TILDE_SIZE, tildeShift } from '@lib/figures/tilde';

interface Props extends MathLabel {
  x: number;
  /** Vertical centre, dominant-baseline: central, like FigText. */
  y: number;
  size?: 'label' | 'small';
  anchor?: 'start' | 'middle' | 'end';
  /** A tilde over the symbol; bold symbols only. */
  tilde?: boolean;
}

const { x, y, symbol, sub, after, before, bold = false, tilde = false, size = 'label', anchor = 'middle' } = Astro.props;
const fontSize = FIG_FONT[size];
let mark: ReturnType<typeof tildeShift> | undefined;
try {
  checkMathLabel(symbol, sub, after, before);
  if (tilde) mark = tildeShift(symbol, bold, fontSize);
} catch (error) {
  throw new Error(`<FigMath> on "${Astro.locals.starlightRoute.id}": ${error instanceof Error ? error.message : String(error)}`);
}
const shift = round1(0.3 * fontSize);
// dy is relative: each tspan undoes what the one before it raised or lowered.
const raisedByMark = mark?.up ?? 0;
const subDy = round1(shift - raisedByMark);
const afterDy = sub !== undefined ? -shift : mark ? -raisedByMark : undefined;
const afterDx = round1(3 + (mark && sub === undefined ? mark.after : 0));
const subItalic = sub !== undefined && /^[A-Za-z]/.test(sub);
---

<text class="atlas-fig-math" font-size={fontSize} text-anchor={anchor === 'middle' ? undefined : anchor} x={x} y={y}>{before !== undefined && <tspan>{before}</tspan>}<tspan class={bold ? 'atlas-fig-math-bold' : undefined} font-style={bold ? undefined : 'italic'} dx={before !== undefined ? 3 : undefined}>{symbol}</tspan>{mark && <tspan font-size={TILDE_SIZE} dx={mark.before} dy={mark.up}>~</tspan>}{sub !== undefined && <tspan font-size={FIG_FONT.small} font-style={subItalic ? 'italic' : undefined} dx={mark?.after} dy={subDy}>{sub}</tspan>}{after !== undefined && <tspan dy={afterDy} dx={afterDx}>{after}</tspan>}</text>

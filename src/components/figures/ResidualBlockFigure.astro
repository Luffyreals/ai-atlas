---
// cv/cnn-image-classification, after "Cách sửa": a residual block (He et al., 2016). One column read top-down:
// the input x, then a frame round 3 × 3 convolution → ReLU → 3 × 3 convolution, named on its left "residual
// F(x)"; the shortcut (dashed, second group) carries x unchanged down the right edge into "add" (accent, the
// point of the block). The arrow out of "add" carries y = F(x) + x, the lesson's formula; then the ReLU after
// the addition, as in the paper, and the output. The frame is a closed FigArrow with no head, so e2e measures
// it (llm-lessons.md 2.9.1). Narrow layout only. Words: src/data/figures/residual-block.ts; x, F(x) and
// y = F(x) + x with FigMath / FigFormula.
import { RESIDUAL_BLOCK } from '@data/figures/residual-block';
import type { Formula } from '@lib/figures/geometry';
import { anchor, closed, type Box } from '@lib/figures/layout';
import { getPageLocale } from '@lib/page-locale';
import FigArrow from './kit/FigArrow.astro';
import FigFormula from './kit/FigFormula.astro';
import FigMath from './kit/FigMath.astro';
import FigNode from './kit/FigNode.astro';
import FigText from './kit/FigText.astro';
import FigureFrame from './kit/FigureFrame.astro';

const t = RESIDUAL_BLOCK[getPageLocale(Astro.locals.starlightRoute)];
const l = t.labels;

// The main column is centred on x 150; the frame round the residual branch spans x 62–238, its name stands
// left of it (x 0–58); the shortcut runs down x 318, its words right-aligned between the frame and the lane.
const MID = 150;
const LANE = 318;
const box = (y: number, width: number, height: number): Box => ({ x: MID - width / 2, y, width, height });

const input = box(8, 160, 55);
const FRAME = { top: 84, bottom: 256, left: 62, right: 238 } as const;
const conv1 = box(98, 160, 36);
const reluIn = box(154, 96, 36);
const conv2 = box(210, 160, 36);
const add = box(280, 72, 36);
const relu = box(352, 96, 36);
const output = box(412, 160, 36);
const height = output.y + output.height + 8;

const frame = closed([
  [FRAME.left, FRAME.top],
  [FRAME.right, FRAME.top],
  [FRAME.right, FRAME.bottom],
  [FRAME.left, FRAME.bottom],
]);
const frameMid = (FRAME.top + FRAME.bottom) / 2;
const nameX = FRAME.left / 2;
const addY = anchor(add, 'right')[1];
const inY = anchor(input, 'right')[1];
const fx: Formula = [{ symbol: 'F' }, '(', { symbol: 'x', bold: true }, ')'];
const y: Formula = [{ symbol: 'y', bold: true }, '=', ...fx, '+', { symbol: 'x', bold: true }];
const yY = (add.y + add.height + relu.y) / 2;
---

<FigureFrame id="residual-block" text={t} narrowHeight={height}>
  <Fragment slot="narrow">
    <FigNode {...input} math={{ symbol: 'x', bold: true }} lines={l.input} />
    <FigArrow from={anchor(input, 'bottom')} to={anchor(conv1, 'top')} />
    <FigArrow {...frame} head={false} />
    <FigText x={nameX} y={frameMid - 12} lines={l.residual} size="small" />
    <FigFormula x={nameX} y={frameMid + 10} parts={fx} />
    <FigNode {...conv1} lines={l.conv} />
    <FigArrow from={anchor(conv1, 'bottom')} to={anchor(reluIn, 'top')} />
    <FigNode {...reluIn} lines={l.relu} />
    <FigArrow from={anchor(reluIn, 'bottom')} to={anchor(conv2, 'top')} />
    <FigNode {...conv2} lines={l.conv} />
    <FigArrow from={anchor(conv2, 'bottom')} to={anchor(add, 'top')} />

    <FigArrow from={anchor(input, 'right')} via={[[LANE, inY], [LANE, addY]]} to={anchor(add, 'right')} tone="alt" />
    <FigText x={LANE - 8} y={frameMid - 8} lines={l.shortcut} size="small" anchor="end" />
    <FigMath x={LANE - 8} y={frameMid + 22} symbol="x" bold size="small" anchor="end" />

    <FigNode {...add} lines={l.add} tone="accent" />
    <FigArrow from={anchor(add, 'bottom')} to={anchor(relu, 'top')} />
    <FigFormula x={MID + 8} y={yY} parts={y} anchor="start" />
    <FigNode {...relu} lines={l.relu} />
    <FigArrow from={anchor(relu, 'bottom')} to={anchor(output, 'top')} />
    <FigNode {...output} lines={l.output} />
  </Fragment>
</FigureFrame>

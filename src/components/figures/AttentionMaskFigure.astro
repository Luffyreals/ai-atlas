---
// nlp/bert, "Minh họa": BERT's encoder lets every token see every token (a full grid); GPT's decoder lets a
// token see only itself and the tokens before it (the lower triangle). Two 5 × 5 grids on one sentence, rows =
// the token being computed, columns = the token looked at; BERT above, GPT below (side by side does not fit
// 360 units with 13-unit token names). A visible cell is filled (a plain box); a masked cell keeps the page
// colour and is crossed out (both diagonals), so the mask is not told by colour alone. The compared cell (row
// "chim", column "bay") is an accent box, 2px border, with an accent ring 3 units outside it, in both grids and
// in the legend; in GPT it is crossed out too.
// The grid lines are one FigArrow polyline (gridLines), the crosses one per row (upperCrosses), both in
// src/lib/figures/layout.ts: 5 elements instead of 50 boxes, within the HTML budget, and measured by the e2e
// contrast check. Beside the grids: the axis notes (BERT) and the legend (GPT).
// Narrow layout only. Words: src/data/figures/attention-mask.ts.
import { ATTENTION_MASK, ATTENTION_MASK_COMPARED } from '@data/figures/attention-mask';
import type { Pt } from '@lib/figures/geometry';
import { gridLines, upperCrosses, type Box } from '@lib/figures/layout';
import { getPageLocale } from '@lib/page-locale';
import FigArrow from './kit/FigArrow.astro';
import FigNode from './kit/FigNode.astro';
import FigText from './kit/FigText.astro';
import FigureFrame from './kit/FigureFrame.astro';

const t = ATTENTION_MASK[getPageLocale(Astro.locals.starlightRoute)];
const l = t.labels;
const tokens = [l.t0, l.t1, l.t2, l.t3, l.t4];
const N = tokens.length;
const [ROW, COL] = ATTENTION_MASK_COMPARED;

// Row names end at x 52; each grid spans x 58–228; notes and legend start at x 240.
const CELL = 34;
const GX = 58;
const SIDE = 240;
const SIDE_TEXT = 270;
const grid = (top: number) => ({ top, title: top - 38, names: top - 14 });
const bert = grid(52);
const gpt = grid(288);
const cell = (top: number, r: number, c: number): Box => ({ x: GX + c * CELL, y: top + r * CELL, width: CELL, height: CELL });
const whole: Box = { x: GX, y: bert.top, width: N * CELL, height: N * CELL };
const lower = Array.from({ length: N }, (_, r) => Array.from({ length: r + 1 }, (_, c) => cell(gpt.top, r, c))).flat();
const centres = tokens.map((_, i) => GX + i * CELL + CELL / 2);
const rowY = (top: number, r: number) => top + r * CELL + CELL / 2;
const polyline = (points: readonly Pt[]) => ({ from: points[0]!, via: points.slice(1, -1), to: points[points.length - 1]! });
/** A closed accent ring 3 units outside a box: with the box's own 2px accent border, the "thick border". */
const ring = (box: Box) => {
  const [l, t, r, b] = [box.x - 3, box.y - 3, box.x + box.width + 3, box.y + box.height + 3];
  return polyline([[l, t], [r, t], [r, b], [l, b], [l, t]]);
};

// Legend, beside the GPT grid: a swatch per kind of cell.
const SWATCH = 22;
const keyY = [gpt.top + 18, gpt.top + 60, gpt.top + 112];
const swatch = (y: number): Box => ({ x: SIDE, y: y - SWATCH / 2, width: SWATCH, height: SWATCH });
const maskedKey = swatch(keyY[1]!);
const [kl, kt, kr, kb] = [maskedKey.x, maskedKey.y, maskedKey.x + SWATCH, maskedKey.y + SWATCH];
const maskedKeyLines: Pt[] = [[kl, kt], [kr, kt], [kr, kb], [kl, kb], [kl, kt], [kr, kb], [kr, kt], [kl, kb]];
const height = gpt.top + N * CELL + 8;
---

<FigureFrame id="attention-mask" text={t} narrowHeight={height}>
  <Fragment slot="narrow">
    {
      [bert, gpt].map((g) => (
        <Fragment>
          <FigText x={8} y={g.title} lines={g === bert ? l.bert : l.gpt} anchor="start" />
          <FigText xs={centres} y={g.names} lines={tokens} size="small" />
          {tokens.map((token, r) => <FigText x={GX - 6} y={rowY(g.top, r)} lines={token} size="small" anchor="end" />)}
        </Fragment>
      ))
    }

    <FigNode {...whole} bare />
    <FigArrow {...polyline(gridLines(GX, bert.top, CELL, N))} head={false} />
    <FigNode {...cell(bert.top, ROW, COL)} tone="accent" bare />
    <FigArrow {...ring(cell(bert.top, ROW, COL))} tone="accent" head={false} />
    <FigText x={SIDE} y={bert.top + 22} lines={l.rows} size="small" anchor="start" />
    <FigText x={SIDE} y={bert.top + 76} lines={l.columns} size="small" anchor="start" />
    <FigText x={SIDE} y={bert.top + 130} lines={l.allSeen} size="small" anchor="start" />

    {lower.map((box) => <FigNode {...box} bare />)}
    <FigArrow {...polyline(gridLines(GX, gpt.top, CELL, N))} head={false} />
    <FigNode {...cell(gpt.top, ROW, COL)} tone="accent" bare />
    {upperCrosses(GX, gpt.top, CELL, N).map((row) => <FigArrow {...polyline(row)} head={false} />)}
    <FigArrow {...ring(cell(gpt.top, ROW, COL))} tone="accent" head={false} />

    <FigNode {...swatch(keyY[0]!)} bare />
    <FigText x={SIDE_TEXT} y={keyY[0]!} lines={l.seen} size="small" anchor="start" />
    <FigArrow {...polyline(maskedKeyLines)} head={false} />
    <FigText x={SIDE_TEXT} y={keyY[1]!} lines={l.masked} size="small" anchor="start" />
    <FigNode {...swatch(keyY[2]!)} tone="accent" bare />
    <FigArrow {...ring(swatch(keyY[2]!))} tone="accent" head={false} />
    <FigText x={SIDE_TEXT} y={keyY[2]!} lines={l.compared} size="small" anchor="start" />
  </Fragment>
</FigureFrame>

---
// GradientDescentViz for ml/gradient-descent (docs/architecture/viz/gradient-descent.md, sections 12.4.4–12.4.5). The only file a
// lesson imports: <GradientDescentViz />, no props, no client:* in MDX. Here, at build time: UI strings and KaTeX
// for the slider label. The island computes the five paths and the nine level curves itself from the 10 rows, with
// the same code at build time and in the browser (section 12.2.4), so nothing but the rows and the config travels
// through props. Axis names are UI strings (w̃, b̃), not the dataset's columns.
// The island hydrates 200px before it scrolls into view. Styles: viz.css, through Starlight's customCss.
import GradientDescentVizIsland from './gradient-descent-viz/GradientDescentVizIsland';
import { APARTMENTS, APARTMENTS_GD } from '@data/datasets/apartments';
import { getStrings } from '@i18n/ui';
import { inlineMarkupLabel, renderInlineMarkup } from '@lib/inline-markup';
import { getPageLocale } from '@lib/page-locale';

const route = Astro.locals.starlightRoute;
const locale = getPageLocale(route);
const strings = getStrings(Astro.locals.t, 'vizGradientDescent');
const tCommon = getStrings(Astro.locals.t, 'common');
---

<div class="atlas-viz not-content" lang={locale} data-pagefind-ignore>
  <GradientDescentVizIsland
    client:visible={{ rootMargin: '200px' }}
    rows={APARTMENTS.rows}
    config={APARTMENTS_GD}
    labels={{ etaHtml: renderInlineMarkup(strings.etaLabel), etaText: inlineMarkupLabel(strings.etaLabel) }}
    strings={strings}
  />
  <noscript><p class="atlas-viz-noscript">{tCommon.needsScript}</p></noscript>
</div>

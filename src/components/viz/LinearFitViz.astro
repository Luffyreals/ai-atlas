---
// LinearFitViz for ml/linear-regression (docs/architecture/viz.md, sections 4.5–4.7). The only file a lesson
// imports: <LinearFitViz />, no props, no client:* in MDX. Here, at build time: UI strings, KaTeX for the
// slider labels and the ŷ, x symbols, the least-squares line (bad data fails the build) and the mean point
// (x̄, ȳ) it passes through, marked on the plot (decision 24 in docs/mvp.md).
// The island hydrates 200px before it scrolls into view. Styles: viz.css, through Starlight's customCss.
import LinearFitVizIsland from './linear-fit-viz/LinearFitVizIsland';
import { APARTMENTS, APARTMENTS_LINEAR_FIT } from '@data/datasets/apartments';
import { getStrings } from '@i18n/ui';
import { inlineMarkupLabel, renderInlineMarkup } from '@lib/inline-markup';
import { getPageLocale } from '@lib/page-locale';
import { axisText } from '@lib/viz/axis';
import { fitLeastSquares, meanPoint } from '@lib/viz/linear-fit';

const route = Astro.locals.starlightRoute;
const locale = getPageLocale(route);
const strings = getStrings(Astro.locals.t, 'vizLinearFit');
const tCommon = getStrings(Astro.locals.t, 'common');

const { x, y } = APARTMENTS;
const best = fitLeastSquares(APARTMENTS.rows);
---

<div class="atlas-viz not-content" lang={locale} data-pagefind-ignore>
  <LinearFitVizIsland
    client:visible={{ rootMargin: '200px' }}
    rows={APARTMENTS.rows}
    config={APARTMENTS_LINEAR_FIT}
    best={best}
    mean={meanPoint(APARTMENTS.rows)}
    axes={{ x: axisText(x, locale), y: axisText(y, locale) }}
    itemLabel={APARTMENTS.itemLabel[locale]}
    description={APARTMENTS.description[locale]}
    labels={{
      wHtml: renderInlineMarkup(strings.wLabel),
      wText: inlineMarkupLabel(strings.wLabel),
      bHtml: renderInlineMarkup(strings.bLabel),
      bText: inlineMarkupLabel(strings.bLabel),
    }}
    symbols={{ yHat: renderInlineMarkup(String.raw`$\hat{y}$`), x: renderInlineMarkup('$x$') }}
    strings={strings}
  />
  <noscript><p class="atlas-viz-noscript">{tCommon.needsScript}</p></noscript>
</div>

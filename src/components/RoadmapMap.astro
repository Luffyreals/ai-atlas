---
// The whole roadmap printed as one atlas plate: core parts, the fork, the three branches.
// Optional route finder: pick a destination, every lesson on the way to it is marked.
// No React: plain HTML plus one small script, so the homepage loads no framework.
import { formatString } from '@i18n/format';
import { getStrings } from '@i18n/ui';
import { LESSONS, PARTS, type LessonId, type Lesson, type Locale, type Part, type PartId } from '@data/roadmap';
import { getLessonUrl, getLessonsByPart, getPartIdOf, hasPage, isTranslated, requireLesson } from '@lib/roadmap';
import { countParts, routeTo } from '@lib/route';
import RouteMark from './home/RouteMark.astro';
import Stripe from './home/Stripe.astro';

interface Props {
  /** Prefix for element ids, so a page can hold more than one map. Default "roadmap". */
  id?: string;
  /** Limit to some parts, e.g. on a part overview page. Default: all parts. */
  parts?: PartId[];
  /** Show the "pick a destination" control. Default false. */
  routeFinder?: boolean;
  /** Destination selected before any interaction (rendered on the server, works without JS). */
  destination?: LessonId;
}

const { id = 'roadmap', parts: only, routeFinder = false, destination } = Astro.props;
const locale = (Astro.locals.starlightRoute.locale ?? 'vi') as Locale;
const t = getStrings(Astro.locals.t, 'roadmap');
const tCommon = getStrings(Astro.locals.t, 'common');

const shown = PARTS.filter((part) => !only || only.includes(part.id));
const core = shown.filter((part) => part.track === 'core');
const branches = shown.filter((part) => part.track === 'branch');
const anyOpen = LESSONS.some((lesson) => hasPage(lesson));

const titleOf = (lesson: Lesson) => (lesson.shortTitle ?? lesson.title)[locale];
const prerequisitesOf = (lessonId: string) => requireLesson(lessonId).prerequisites;

/** "Python 4 → Toán cho AI 2 → …": lessons on a route, counted part by part in road order. */
function pathOf(route: Set<string>): string {
  return PARTS.map((part) => {
    const n = [...route].filter((lessonId) => getPartIdOf(lessonId as LessonId) === part.id).length;
    return n > 0 ? `${part.title[locale]} ${n}` : '';
  })
    .filter(Boolean)
    .join(' → ');
}

const initialRoute = destination ? routeTo(destination, prerequisitesOf) : new Set<string>();
const initialResult = destination
  ? formatString(t.routeResult, {
      lesson: titleOf(requireLesson(destination)),
      count: initialRoute.size,
      parts: countParts(initialRoute),
    })
  : '';

/** Lessons of a part, grouped by section when the part has sections. */
function groupsOf(part: Part): { title?: string; lessons: Lesson[] }[] {
  const lessons = getLessonsByPart(part.id);
  if (!part.sections) return [{ lessons }];
  return part.sections.map((section) => ({
    title: section.title[locale],
    lessons: lessons.filter((lesson) => lesson.section === section.id),
  }));
}

// When only some parts are drawn, the browser still needs the whole graph to follow a route.
const graph = only
  ? JSON.stringify({
      prerequisites: Object.fromEntries(LESSONS.map((lesson) => [lesson.id, lesson.prerequisites])),
      partTitles: Object.fromEntries(PARTS.map((part) => [part.id, part.title[locale]])),
      partOrder: PARTS.map((part) => part.id),
    })
  : undefined;
const finderId = `${id}-destination`;
---

<div class="roadmap" data-roadmap>
  <Stripe id={`${id}-stripe`} class="roadmap-stripe" />
  <div class="roadmap-inner">
    <div class="roadmap-head">
      <div class="roadmap-title"><slot name="title" /></div>
      <div class="roadmap-intro"><slot name="intro" /></div>
    </div>

    {
      routeFinder && (
        <div class="route-finder">
          <label for={finderId}>{t.routeLabel}</label>
          <div class="route-controls">
            <select id={finderId} data-route-select>
              {shown.map((part) => (
                <optgroup label={part.title[locale]}>
                  {getLessonsByPart(part.id).map((lesson) => (
                    <option value={lesson.id} selected={lesson.id === destination}>
                      {titleOf(lesson)}
                    </option>
                  ))}
                </optgroup>
              ))}
            </select>
            <button type="button" class="route-show" data-route-show>
              {t.showOnMap}
            </button>
          </div>
          <div aria-live="polite">
            <p class="route-result" data-route-result data-template={t.routeResult}>
              {initialResult}
            </p>
            <p class="route-path" data-route-path>
              {pathOf(initialRoute)}
            </p>
          </div>
        </div>
      )
    }

    {
      [core, branches].map((group, groupIndex) => (
        <>
          {groupIndex === 1 && branches.length > 0 && (
            <p class="roadmap-fork">
              <RouteMark class="roadmap-fork-mark" />
              <span>{t.branchNote}</span>
            </p>
          )}
          <div class:list={['roadmap-parts', groupIndex === 0 ? 'is-core' : 'is-branches']}>
            {group.map((part) => (
              <section
                class:list={['roadmap-part', { 'has-sections': Boolean(part.sections) }]}
                aria-labelledby={`${id}-${part.id}`}
                data-part={part.id}
                data-part-title={part.title[locale]}
              >
                <div class="part-head">
                  <h3 id={`${id}-${part.id}`} class="part-title">
                    {part.title[locale]}
                  </h3>
                  <p class="part-count">{formatString(t.lessons, { count: getLessonsByPart(part.id).length })}</p>
                </div>
                <div class="part-groups">
                  {groupsOf(part).map((sectionGroup) => (
                    <div class="part-group">
                      {sectionGroup.title && <h4 class="part-section">{sectionGroup.title}</h4>}
                      <ol class="part-lessons">
                        {sectionGroup.lessons.map((lesson) => (
                          <li
                            data-lesson-id={lesson.id}
                            data-prerequisites={lesson.prerequisites.join(' ')}
                            data-on-route={initialRoute.has(lesson.id) ? '' : undefined}
                            data-destination={lesson.id === destination ? '' : undefined}
                          >
                            {hasPage(lesson) ? (
                              <a href={getLessonUrl(lesson.id, locale)}>
                                {titleOf(lesson)}
                                {!isTranslated(lesson, locale) && <span class="lesson-note">{tCommon.notTranslated}</span>}
                              </a>
                            ) : (
                              <span class="is-soon">
                                {titleOf(lesson)}
                                <span class="sr-only"> ({tCommon.comingSoon})</span>
                              </span>
                            )}
                          </li>
                        ))}
                      </ol>
                    </div>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </>
      ))
    }

    <p class="roadmap-legend">
      {
        anyOpen ? (
          <>
            <span class="legend-open">{t.legendOpen}</span>
            <span class="legend-soon">{t.legendSoon}</span>
          </>
        ) : (
          <span class="legend-soon">{t.legendNone}</span>
        )
      }
    </p>
  </div>
  {graph && <script type="application/json" data-roadmap-graph set:html={graph} />}
</div>

<style>
  .roadmap {
    background: var(--atlas-paper);
    color: var(--atlas-paper-ink);
    --stripe-height: 28px;
  }

  .roadmap-stripe {
    color: var(--atlas-paper-ink);
  }

  .roadmap-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    padding: 32px 20px 48px;
  }

  .roadmap-head {
    display: grid;
    gap: 16px;
  }

  .roadmap-title :global(h2) {
    margin: 0;
    font-size: var(--step-head);
  }

  .roadmap-intro :global(p) {
    max-width: 44ch;
    margin: 0;
    font-size: var(--step-lead);
    line-height: 1.3;
  }

  .route-finder {
    display: grid;
    gap: 12px;
    padding: 20px;
    background: var(--atlas-paper-step);
  }

  .route-finder label {
    font-weight: 600;
  }

  .route-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .route-finder select {
    flex: 1 1 18rem;
    /* A long lesson title must not widen the plate on a phone. */
    min-width: 0;
    width: 100%;
    max-width: 32rem;
    min-height: 48px;
    padding: 0 12px;
    border: 0;
    background: var(--atlas-paper-ink);
    color: var(--atlas-paper);
    font: inherit;
    cursor: pointer;
  }

  .route-show {
    min-height: 48px;
    padding: 0 20px;
    border: 0;
    background: var(--atlas-field);
    color: var(--atlas-field-ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .route-show:hover {
    transform: translateY(-2px);
  }

  .route-result {
    max-width: 60ch;
    min-height: 1.5em;
    margin: 0;
    font-size: var(--step-lead);
    line-height: 1.3;
  }

  .route-path {
    max-width: 70ch;
    margin: 6px 0 0;
    color: var(--atlas-paper-muted);
  }

  .roadmap-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin: 0;
    font-size: var(--step-small);
  }

  .legend-open {
    font-weight: 600;
  }

  .legend-soon {
    color: var(--atlas-paper-muted);
  }

  .roadmap-parts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }

  .part-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
    margin: 0 0 12px;
    padding: 12px 0 10px;
    border-bottom: 4px solid var(--atlas-paper-ink);
  }

  .part-title {
    font-size: var(--step-lead);
  }

  .part-count {
    margin: 0;
    font-size: var(--step-small);
    color: var(--atlas-paper-muted);
  }

  .part-groups {
    display: grid;
    gap: 20px;
  }

  .part-section {
    margin: 0 0 6px;
    font-family: var(--sl-font);
    font-size: var(--step-small);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .part-lessons {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step-body, 1.0625rem);
  }

  .part-lessons li {
    margin: 0 -8px;
    padding: 4px 8px;
    line-height: 1.35;
    scroll-margin: 40vh 0;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .part-lessons a {
    color: var(--atlas-paper-ink);
    font-weight: 600;
    text-decoration-color: var(--atlas-field);
    text-underline-offset: 3px;
  }

  .is-soon {
    color: var(--atlas-paper-muted);
  }

  .lesson-note {
    margin-inline-start: 6px;
    font-size: var(--step-small);
    font-weight: 400;
  }

  .part-lessons li[data-on-route] {
    background: var(--atlas-field);
  }

  .part-lessons li[data-on-route] .is-soon {
    color: var(--atlas-field-ink);
  }

  .part-lessons li[data-destination] {
    background: var(--atlas-paper-ink);
  }

  .part-lessons li[data-destination] :is(a, .is-soon) {
    color: var(--atlas-paper);
  }

  .roadmap-fork {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 8px 0 0;
    font-family: var(--atlas-font-display);
    font-size: var(--step-lead);
    font-weight: 700;
    line-height: 1.1;
  }

  .roadmap-fork-mark {
    height: 48px;
    color: var(--atlas-paper-ink);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 40rem) {
    .roadmap-inner {
      padding: 40px 40px 56px;
    }

    .roadmap-parts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .roadmap {
      --stripe-height: 40px;
    }

    .roadmap-inner {
      gap: 40px;
      padding: 56px 56px 72px;
    }

    .roadmap-head {
      grid-template-columns: 5fr 7fr;
      align-items: end;
      gap: 40px;
    }

    .roadmap-parts.is-core {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    /* The large LLM part takes two columns, one per section, so the plate ends evenly. */
    .roadmap-parts.is-branches {
      grid-template-columns: 1fr 1fr 2fr;
    }

    .roadmap-part.has-sections .part-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 32px;
    }
  }
</style>

<script>
  import { formatString } from '../i18n/format';
  import { countParts, routeTo } from '../lib/route';

  interface Graph {
    prerequisites: Record<string, string[]>;
    partTitles: Record<string, string>;
    partOrder: string[];
  }

  // Route finder: mark every lesson on the way to the chosen destination.
  for (const map of document.querySelectorAll<HTMLElement>('[data-roadmap]')) {
    const select = map.querySelector<HTMLSelectElement>('[data-route-select]');
    const result = map.querySelector<HTMLElement>('[data-route-result]');
    const path = map.querySelector<HTMLElement>('[data-route-path]');
    const show = map.querySelector<HTMLButtonElement>('[data-route-show]');
    if (!select || !result) continue;

    const items = new Map<string, HTMLElement>();
    for (const item of map.querySelectorAll<HTMLElement>('[data-lesson-id]')) {
      items.set(item.dataset.lessonId!, item);
    }

    // The whole graph comes from the embedded JSON when only some parts are drawn, else from the DOM.
    const embedded = map.querySelector<HTMLScriptElement>('[data-roadmap-graph]');
    const graph: Graph = embedded
      ? JSON.parse(embedded.textContent ?? '{}')
      : {
          prerequisites: Object.fromEntries(
            [...items].map(([id, item]) => [id, (item.dataset.prerequisites ?? '').split(' ').filter(Boolean)]),
          ),
          partTitles: Object.fromEntries(
            [...map.querySelectorAll<HTMLElement>('[data-part]')].map((part) => [part.dataset.part!, part.dataset.partTitle!]),
          ),
          partOrder: [...map.querySelectorAll<HTMLElement>('[data-part]')].map((part) => part.dataset.part!),
        };
    const prerequisitesOf = (id: string) => graph.prerequisites[id] ?? [];
    const partOf = (id: string) => id.slice(0, id.indexOf('/'));

    const apply = () => {
      const destination = select.value;
      if (!destination) return;
      const route = routeTo(destination, prerequisitesOf);
      for (const [id, item] of items) {
        item.toggleAttribute('data-on-route', route.has(id));
        item.toggleAttribute('data-destination', id === destination);
      }
      result.textContent = formatString(result.dataset.template ?? '', {
        lesson: select.selectedOptions[0]?.textContent?.trim() ?? destination,
        count: route.size,
        parts: countParts(route),
      });
      if (path) {
        path.textContent = graph.partOrder
          .map((part) => {
            const n = [...route].filter((id) => partOf(id) === part).length;
            return n > 0 ? `${graph.partTitles[part] ?? part} ${n}` : '';
          })
          .filter(Boolean)
          .join(' → ');
      }
    };

    select.addEventListener('change', apply);
    // The browser may restore another choice on reload or Back; draw what the select shows.
    window.addEventListener('pageshow', apply);
    apply();

    show?.addEventListener('click', () => {
      const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      map.querySelector('[data-destination]')?.scrollIntoView({ block: 'center', behavior: smooth ? 'smooth' : 'auto' });
    });
  }
</script>
